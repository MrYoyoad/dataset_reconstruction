# ============================================================
# Top-level .gitignore for Thesis repo
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Environments ---
.env
.venv
env/
venv/

# --- IDE ---
.idea/
.vscode/
.vscode-server/
*.swp
*.swo

# --- Jupyter ---
.ipynb_checkpoints/

# --- macOS ---
.DS_Store

# --- Data files (large, downloaded at runtime) ---
data/
datasets/
dataset_reconstruction/data/

# --- Model weights (large binary files) ---
models/*.pth
dataset_reconstruction/models/*.pth
dataset_reconstruction/models/*.pt
results/*.pth

# --- Dataset reconstruction artifacts ---
dataset_reconstruction/reconstructions/*.pt
dataset_reconstruction/reconstructions/*.png
dataset_reconstruction/Miniforge3-*.sh

# --- WEXAC job logs (ephemeral cluster output) ---
*.err
*.out
exp_*_gpu_err.txt
exp_*_gpu_out.txt
exp_*_log.txt
rank_sweep_*.txt
wexac_jupyter_info.txt
wexac_jupyter_log.txt
wexac_gpu_jupyter.sh
wexac_bsub_out.txt
wexac_bsub_err.txt
wexac_gpu_mode.txt

# --- Claude Code workspace (local state, not shared) ---
.claude/
!.claude/commands/
.claude.json
.claude.json.backup

# --- Git credentials (NEVER commit) ---
.git-credentials

# --- System / user home dotfiles ---
.bash_history
.bash_logout
.bash_profile
.bashrc
.conda/
.cache/
.config/
.dotnet/
.ipython/
.jupyter/
.local/
.nv/
.ssh/
.wexac_jlab/
.apptainer/

# --- Misc binaries ---
code
vscode_cli.tar.gz
*.tar.gz

# --- Empty dirs ---
envs/

# --- Test/coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Papers (PDFs tracked selectively — see papers/) ---
# Large PDFs in dataset_reconstruction/ are not tracked
dataset_reconstruction/THE_PAPER.pdf

# --- WandB ---
wandb/

# --- Shared home dir junk (WEXAC artifacts from other users/projects) ---
dataset_reconstruction/.*.clientCache.*
dataset_reconstruction/.lsb*
dataset_reconstruction/claude-*
dataset_reconstruction/claude/
dataset_reconstruction/cursor-*
dataset_reconstruction/matlabls_*/
dataset_reconstruction/python-languageserver-cancellation/
dataset_reconstruction/vscode-ssh-auth-sock-*
dataset_reconstruction/install-tl-*/
dataset_reconstruction/*.mps
dataset_reconstruction/lior/
dataset_reconstruction/oxoG_test/
dataset_reconstruction/generally_useful/

# --- Other user's files that leaked into this dir ---
dataset_reconstruction/ruth_thesis*
dataset_reconstruction/*.R
dataset_reconstruction/*.tsv
dataset_reconstruction/*.pdb
dataset_reconstruction/*.md
dataset_reconstruction/gff
dataset_reconstruction/gff3
dataset_reconstruction/nextflow
dataset_reconstruction/1
dataset_reconstruction/2
dataset_reconstruction/*.png
dataset_reconstruction/*.jpg
dataset_reconstruction/*.txt
dataset_reconstruction/!dataset_reconstruction/README.md

# --- LaTeX build artifacts ---
notes/*.aux
notes/*.log
notes/*.out
notes/*.pdf
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

# --- Intermediate reconstruction snapshots (many small PNGs, MB-sized dirs) ---
figures/snapshots/
figures/**/snapshots/
figures/**/snapshots_*/

# --- Private face photos (not for git) ---
figures/Gal photo/
assets/gal_photo/

# --- Misc ---
.python_history
.wget-hsts
Untitled.ipynb
dataset_reconstruction/claude_permission_email_last_sent
dataset_reconstruction/tmp_read_resource_*
